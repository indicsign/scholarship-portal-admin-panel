# Copy to .env. Both the Vite dev server and docker compose read that file, and
# neither is committed — see .gitignore.
#
# The names are split by who reads them: VITE_* are build-time settings, baked
# into the bundle or used by the dev server's proxy. The rest are read by
# docker-compose.yml and by the container at start-up.

# --- development (npm run dev / npm run preview) -----------------------------

# The API this panel talks to. Vite proxies /api to it, so the browser sees one
# origin and the HttpOnly refresh cookie is sent without any cross-origin
# credentials handling. A variable set in the shell overrides this file.
VITE_API_TARGET=https://api.anyserver.site/

# Must match API_VERSION on the server. The panel builds every request path
# from this, so pointing at a v2 backend is a one-line change.
#
# Only ever set this to a version the server actually serves: it is compiled
# into the bundle, and a mismatch makes every request a 404 that nothing in the
# panel can explain.
VITE_API_VERSION=v1

# --- the container (docker compose) ------------------------------------------

# Where the API is, for the nginx inside the image: scheme://host[:port]. This
# is the deployed equivalent of VITE_API_TARGET above, and it is read at start-up
# rather than baked in — the same image serves any environment. A trailing slash
# is stripped; a missing scheme is refused with a message rather than a broken
# proxy; anything after the host is prefixed to every proxied path, which is
# right for an API mounted under a path and wrong otherwise, and is logged.
#
# The default is the API's compose service name, which only resolves when this
# container shares a network with it.
#API_TARGET=https://api.anyserver.site

# The build argument for VITE_API_VERSION when compose builds the image, kept
# under the server's own name because it is the server's version.
#API_VERSION=v1

# The image to run. Deploy a commit tag rather than :latest — it names exactly
# one build, and CI pushes both.
#ADMIN_IMAGE=indicsign/sp-admin:latest

# Where the panel is published on the host. Loopback by default: the API sets
# the refresh cookie Secure in production, so the panel has to be served over
# HTTPS, which means something terminating TLS in front of this container.
#ADMIN_BIND=127.0.0.1
#ADMIN_PORT=5174

# Who resolves API_TARGET. Docker's embedded DNS exists on a compose network but
# not on the default bridge, so a plain `docker run` needs a real resolver here
# or every proxied request answers 502.
#DNS_RESOLVER=127.0.0.11
